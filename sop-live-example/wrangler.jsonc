{
  "name": "sop-live-example",
  "compatibility_date": "2026-09-03",
  "account_id": "f215f8ca79dd9d53b04618556593a581",
  "workers_dev": true,
  "preview_urls": true,
  "main": "src/index.js",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  }
}
